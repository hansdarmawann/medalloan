# PostgreSQL Connection Configuration
# Copy this file to .env and fill in your actual values

DB_HOST=localhost
DB_PORT=5432
DB_NAME=retailion
DB_USER=postgres
DB_PASSWORD=postgres

# Data-quality contract policy: STOP, WARN, or QUARANTINE
QUALITY_FAILURE_MODE=STOP
QUALITY_RULE_VERSION=1.0.0
PIPELINE_SLA_SECONDS=3600
DATA_RETENTION_DAYS=90
AUDIT_ENCRYPTION_KEY=replace-with-a-secret-key
